# ProbeOne 配置样例
#
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，真实密钥绝不入库。
#
# 唯一必须设置的是 PROBEONE_MASTER_KEY：
#   openssl rand -base64 32

# ========== 服务端 ==========
PROBEONE_HTTP_PORT=8000
PROBEONE_GRPC_PORT=8008
# 对外访问地址，用于生成 Agent 安装命令与告警中的面板链接
PROBEONE_PUBLIC_URL=https://probe.example.com

# gRPC TLS 证书（两端同时设置才生效）
PROBEONE_TLS_CERT=
PROBEONE_TLS_KEY=
# mTLS 客户端 CA，开启后 Agent 需持证书才能连接
PROBEONE_MTLS_CA=

# ========== 数据库 ==========
# driver 只支持 sqlite 或 postgres
PROBEONE_DB_DRIVER=sqlite
PROBEONE_DB_PATH=./data/probeone.db
# driver=postgres 时必填
PROBEONE_DB_DSN=
PROBEONE_DB_MAX_OPEN_CONNS=25
PROBEONE_DB_MAX_IDLE_CONNS=5
# 支持 30s / 5m / 1h 或纯秒数 30
PROBEONE_DB_CONN_MAX_LIFETIME=1h

# ========== Agent 对接 ==========
PROBEONE_AGENT_HANDSHAKE_TIMEOUT=10
# 连续握手失败达到该次数后临时锁定
PROBEONE_AGENT_MAX_FAILURES=5
PROBEONE_AGENT_LOCK_DURATION=5m
# 达到该次数后长时间封禁
PROBEONE_AGENT_HARD_LOCK_AFTER=20
PROBEONE_AGENT_HARD_LOCK_HOURS=24
PROBEONE_AGENT_REPORT_INTERVAL=10
PROBEONE_AGENT_HEARTBEAT=30
# session TTL = 报告间隔 × 该倍数
PROBEONE_AGENT_SESSION_TTL_MULT=3

# ========== 采集与保留 ==========
PROBEONE_WEB_INTERVAL=15
# 离线判定宽限 = 3 × 采集间隔 + 20s
PROBEONE_OFFLINE_GRACE=50
PROBEONE_ROLLUP_INTERVAL=5m
PROBEONE_RETENTION_RAW_DAYS=7
PROBEONE_RETENTION_ROLLUP1M_DAYS=30
PROBEONE_RETENTION_ROLLUP1H_DAYS=365
PROBEONE_RETENTION_MONITOR_DAYS=90
PROBEONE_RETENTION_AUDIT_DAYS=180

# ========== 告警 ==========
PROBEONE_ALERT_DEDUP_WINDOW=30m
# 同目标每小时超过该数量触发静默
PROBEONE_ALERT_STORM_THRESHOLD=3
PROBEONE_ALERT_STORM_SILENCE=1h
PROBEONE_ALERT_MAX_QUEUE=10000

# ========== 安全 ==========
# 必填！生成方式：openssl rand -base64 32
# 用于加密通知通道凭据，首次启动会校验长度
PROBEONE_MASTER_KEY=
PROBEONE_ALLOW_REGISTRATION=false
PROBEONE_PASSWORD_MIN_LENGTH=10
PROBEONE_MAX_LOGIN_FAILURES=3
PROBEONE_LOGIN_LOCK_MINUTES=15
# 生产环境必须为 true（Cookie 的 Secure 属性）
PROBEONE_COOKIE_SECURE=true
# 反代信任链。配错的后果见 docs/deploy.md：
#   直接对外 → 留空
#   同机 Nginx → 127.0.0.1
#   Docker + 反代 → 172.17.0.0/16
#   切勿填 0.0.0.0/0，任何人都能伪造 X-Forwarded-For
PROBEONE_TRUST_PROXY=
# 是否允许监控内网地址。默认关闭以防 SSRF（PRD T11）
PROBEONE_ALLOW_INTERNAL_TARGETS=false

# ========== 可见性策略 ==========
# 状态页是否展示节点（关闭则状态页只显示网站监控）
PROBEONE_VISIBILITY_STATUS_NODES=true
# 公网 IP 掩码：hide | country_only | first_two_octets | first_three_octets
# hide = 完全不返回 IP。默认值最保守
PROBEONE_VISIBILITY_PUBLIC_IP_MASK=hide
PROBEONE_VISIBILITY_RELOAD_SEC=60

# ========== 日志 ==========
PROBEONE_LOG_LEVEL=info
# json 用于生产，text 便于本地调试
PROBEONE_LOG_FORMAT=json
PROBEONE_LOG_MAX_SIZE_MB=100
PROBEONE_LOG_MAX_BACKUPS=5

PROBEONE_TZ=Asia/Shanghai

# ========== Agent 端（被监控主机上使用）==========
# 下面这些由一键安装脚本自动写入配置文件，一般无需手填
# PROBEONE_AGENT_SERVER=probe.example.com:8008
# PROBEONE_AGENT_UUID=
# PROBEONE_AGENT_SECRET=
# PROBEONE_AGENT_INTERVAL=10
# PROBEONE_AGENT_LOG_LEVEL=info
# 断网缓存
# PROBEONE_AGENT_BUFFER=false
