# ProbeOne 服务端配置示例
#
# 复制为 .env 并按需修改：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，绝不要提交真实密钥。
# 下面所有占位值都必须替换——特别是 MASTER_KEY。
#
# 全部配置项都有默认值，唯独 MASTER_KEY 在生产环境必须显式设置：
#   openssl rand -base64 32

# ---------- 服务监听 ----------
PROBEONE_HTTP_PORT=8000
PROBEONE_GRPC_PORT=8008

# 对外访问地址。会拼进 Agent 的一键安装命令，
# 填错会导致用户执行安装命令后连不上。
# 带协议，如 https://probe.example.com
PROBEONE_PUBLIC_URL=http://localhost:8000

# ---------- 数据库 ----------
# 当前仅支持 sqlite（PostgreSQL 驱动尚未实现）
PROBEONE_DB_DRIVER=sqlite
PROBEONE_DB_PATH=./data/probeone.db
PROBEONE_DB_MAX_OPEN_CONNS=25
PROBEONE_DB_MAX_IDLE_CONNS=5
PROBEONE_DB_CONN_MAX_LIFETIME=1h

# ---------- 安全 ----------
# 必填！用于加密通知通道凭据等敏感数据。
# 生成：openssl rand -base64 32
# 一旦设定就不能改——改了会导致已加密的数据无法解密。
PROBEONE_MASTER_KEY=

# 密码最小长度
PROBEONE_PASSWORD_MIN_LENGTH=10

# 登录失败锁定：连续失败 N 次锁M 分钟
PROBEONE_MAX_LOGIN_FAILURES=3
PROBEONE_LOGIN_LOCK_MINUTES=15

# 是否允许自助注册。生产环境应保持false。
PROBEONE_ALLOW_REGISTRATION=false

# Cookie 是否加 Secure 标记。
# 纯 HTTP 部署时必须设为 false，否则浏览器不发送 Cookie（导致登录态丢失）。
PROBEONE_COOKIE_SECURE=true

# ---------- TLS（Agent 连接）----------
# 留空则明文运行，仅建议本地调试时使用。
# 生产环境务必配置双向 TLS，路径指向服务器证书。
PROBEONE_TLS_CERT=
PROBEONE_TLS_KEY=

# Agent 客户端证书的 CA。配了即启用 mTLS，
# 只有持有该 CA 签发证书的 Agent 才能连上。
PROBEONE_MTLS_CA=

# ---------- 反向代理 ----------
# 声明哪些来源 IP 可信为反向代理，逗号分隔 CIDR。
# 只有来自这些网段的请求才采信 X-Forwarded-For。
#
# 配错的后果（PRD 13 章）：
#   留空      → 审计日志记录的是代理 IP，失去溯源能力
#   填 0.0.0.0/0 → 任何人可伪造来源 IP，审计完全失效
PROBEONE_TRUST_PROXY=

# ---------- Agent 接入 ----------
PROBEONE_AGENT_HANDSHAKE_TIMEOUT=10s
PROBEONE_AGENT_REPORT_INTERVAL=10s
PROBEONE_AGENT_HEARTBEAT=30s
# 连续握手失败 N 次开始限流
PROBEONE_AGENT_MAX_FAILURES=5
PROBEONE_AGENT_LOCK_DURATION=5m
# 累计失败 M 次后长期封禁（小时数由下一项决定）
PROBEONE_AGENT_HARD_LOCK_AFTER=20
PROBEONE_AGENT_HARD_LOCK_HOURS=24
PROBEONE_AGENT_SESSION_TTL_MULT=3

# ---------- 采集 ----------
PROBEONE_WEB_INTERVAL=15s

# ---------- 告警 ----------
# 同 (规则, 目标, 级别) 在窗口内只通知一次，避免刷屏
PROBEONE_ALERT_DEDUP_WINDOW=30m
# 同目标 1 小时内超过 N 条则静默
PROBEONE_ALERT_STORM_THRESHOLD=3
PROBEONE_ALERT_STORM_SILENCE=1h
PROBEONE_ALERT_MAX_QUEUE=10000

# ---------- 数据保留 ----------
PROBEONE_RETENTION_RAW_DAYS=7
PROBEONE_RETENTION_ROLLUP1M_DAYS=30
PROBEONE_RETENTION_ROLLUP1H_DAYS=365
PROBEONE_RETENTION_MONITOR_DAYS=90
PROBEONE_RETENTION_AUDIT_DAYS=180

# ---------- 日志 ----------
# format 可选 json / text。生产用 json，便于日志系统采集。
PROBEONE_LOG_LEVEL=info
PROBEONE_LOG_FORMAT=json
PROBEONE_LOG_MAX_SIZE_MB=100
PROBEONE_LOG_MAX_BACKUPS=5
